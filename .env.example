# Application Settings
APP_TITLE=Wi-Fi Invités Homelab
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change_this_secret_key_in_production
ADMIN_PASSWORD=admin123

# Wi-Fi Network Default Parameters
WIFI_SSID=Public-Test
WIFI_PASSWORD=
WIFI_SECURITY=WPA

# Aruba Integration Mode
# Options: mock, instant, central
ARUBA_MODE=instant

# Aruba Instant AP Configuration
ARUBA_INSTANT_HOST=https://192.168.1.1:4343
ARUBA_INSTANT_USERNAME=admin
ARUBA_INSTANT_PASSWORD=your_iap_password_here
ARUBA_INSTANT_VERIFY_SSL=false
ARUBA_MPSK_PROFILE=MPSK_GUEST

# Aruba Central API Settings (Optional if using Central mode)
ARUBA_CENTRAL_BASE_URL=https://eu-apigw.central.arubanetworks.com
ARUBA_CENTRAL_CLIENT_ID=your_client_id
ARUBA_CENTRAL_CLIENT_SECRET=your_client_secret
ARUBA_CENTRAL_CUSTOMER_ID=your_customer_id
ARUBA_CENTRAL_TOKENS_FILE=aruba_tokens.json

# Background Cleanup Interval (seconds)
CLEANUP_CHECK_INTERVAL=60
